# Copy this file to .env and fill in your real values
# .env is blocked by .gitignore — never commit it

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jobtracker
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JWT (generate a strong random string — at least 256 bits)
JWT_SECRET=your_very_long_and_secret_jwt_key_here
JWT_EXPIRATION_MS=86400000

# AI (for later — leave blank for now)
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
